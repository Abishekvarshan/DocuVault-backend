# Export these before starting, or run: node --env-file=.env src/index.js
PORT=4000
# Set to the deployed Vercel origin, e.g. https://docuvault-frontend.vercel.app
FRONTEND_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=documents
JWT_SECRET=change-this-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
MAX_UPLOAD_MB=60
# Optional: defaults to ../storage
# STORAGE_DIR=/absolute/path/to/storage
